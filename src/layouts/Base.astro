---
import '../styles/fonts.css';
import '../styles/global.css';
import '../styles/sections.css';
import { asset, getContent } from '../lib/content';

interface Props {
  title?: string;
  description?: string;
  /** Fuerza noindex en una página concreta. Por defecto lo decide `meta.indexable`. */
  noindex?: boolean;
}
const { meta, brand, contact } = await getContent();
const title = Astro.props.title ?? meta.title;
const description = Astro.props.description ?? meta.description;
const noindex = Astro.props.noindex ?? !meta.indexable;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const abs = (path: string) => (Astro.site ? new URL(asset(path), Astro.site).href : asset(path));
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: brand.name,
  legalName: `${brand.name} ${brand.suffix}`,
  url: Astro.site?.href,
  logo: abs('/icon-512.png'),
  email: contact.email,
  areaServed: 'Worldwide',
  address: { '@type': 'PostalAddress', addressLocality: 'Ciego de Ávila', addressCountry: 'CU' },
};
---

<!doctype html>
<html lang={meta.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_LA" />
    <meta property="og:image" content={abs('/og-image.png')} />
    <meta name="twitter:card" content="summary_large_image" />
    {canonical && <link rel="canonical" href={canonical} />}
    {/* Favicon que sigue el tema del navegador: marino y oro en claro, blanco y oro en oscuro.
        SVG adaptable (Chrome, Edge, Firefox) + ICO claro/oscuro de respaldo. */}
    <link rel="icon" href={asset('/favicon.ico')} sizes="32x32" />
    <link rel="icon" href={asset('/favicon-dark.ico')} sizes="32x32" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href={asset('/favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={asset('/apple-touch-icon.png')} />
    <link rel="manifest" href={asset('/manifest.webmanifest')} />
    <meta name="theme-color" content="#0A1420" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <slot />
    <script>
      const header = document.getElementById('siteHeader');
      const onScroll = () => header?.classList.toggle('scrolled', window.scrollY > 40);
      window.addEventListener('scroll', onScroll, { passive: true });
      onScroll();

      const toggle = document.getElementById('menuToggle');
      const setMenu = (open: boolean) => {
        document.body.classList.toggle('menu-open', open);
        toggle?.setAttribute('aria-expanded', String(open));
        toggle?.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
      };
      toggle?.addEventListener('click', () => setMenu(!document.body.classList.contains('menu-open')));
      document.getElementById('mobileNav')?.addEventListener('click', (e) => {
        if ((e.target as HTMLElement).closest('a')) setMenu(false);
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') setMenu(false);
      });
      window.matchMedia('(min-width: 961px)').addEventListener('change', (e) => {
        if (e.matches) setMenu(false);
      });

      const els = document.querySelectorAll('.reveal');
      if (!('IntersectionObserver' in window)) {
        els.forEach((el) => el.classList.add('in-view'));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('in-view');
                io.unobserve(e.target);
              }
            }
          },
          { threshold: 0.1, rootMargin: '0px 0px -60px 0px' },
        );
        els.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
