---
import PageLayout from '../../layouts/PageLayout.astro';
import PageHero from '../../components/PageHero.astro';
import { getLegalPages } from '../../lib/content';
import { render } from 'astro:content';

export async function getStaticPaths() {
  const pages = await getLegalPages();
  return pages.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
---

<PageLayout title={`${d.title} — NOVATIC`} description={d.description} contact={false}>
  <PageHero title={d.title} crumbs={[{ label: d.title }]} />
  <section class="section">
    <div class="container prose-wrap">
      {d.draft && <p class="notice">Documento en revisión legal.</p>}
      <div class="prose">
        <Content />
      </div>
      <p class="prose-date">Actualizado: {d.updated}</p>
    </div>
  </section>
</PageLayout>
