---
import PageLayout from '../../layouts/PageLayout.astro';
import PageHero from '../../components/PageHero.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import Process from '../../components/Process.astro';
import { getContent, getServices } from '../../lib/content';

const { sections } = await getContent();
const head = sections.services;
const services = await getServices();
---

<PageLayout title={`${head.kicker} — NOVATIC`} description={head.subtitle}>
  <PageHero kicker={head.kicker} title={head.title} lead={head.subtitle} crumbs={[{ label: head.kicker }]} />
  <section class="section">
    <div class="container">
      <div class="offers">
        {services.map((s) => <ServiceCard entry={s} />)}
      </div>
      <p class="section-note reveal">{head.note}</p>
    </div>
  </section>
  <Process />
</PageLayout>
