---
import { getContent } from '../lib/content';
import SectionHead from './SectionHead.astro';
const { pillars } = await getContent();
---

<section class="section" id="plataforma">
  <div class="container">
    <SectionHead kicker={pillars.kicker} title={pillars.title} subtitle={pillars.subtitle} />
    <div class="pillars-grid">
      {pillars.items.map((p) => (
        <article class="pillar reveal">
          <div class="pillar-tag">{p.tag}</div>
          <h3 class="pillar-name">{p.name}</h3>
          <p class="pillar-desc">{p.desc}</p>
          <ul class="pillar-features">
            {p.features.map((f) => <li>{f}</li>)}
          </ul>
        </article>
      ))}
    </div>
  </div>
</section>
