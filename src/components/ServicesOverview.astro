---
import { getContent, getServices } from '../lib/content';
import SectionHead from './SectionHead.astro';
import ServiceCard from './ServiceCard.astro';

const { sections } = await getContent();
const head = sections.services;
const services = await getServices();
---

<section class="section" id="servicios">
  <div class="container">
    <SectionHead kicker={head.kicker} title={head.title} subtitle={head.subtitle} />
    <div class="offers">
      {services.map((s) => <ServiceCard entry={s} />)}
    </div>
    <p class="section-note reveal">{head.note}</p>
  </div>
</section>
