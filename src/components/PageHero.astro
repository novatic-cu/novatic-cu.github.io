---
import { asset } from '../lib/content';

interface Crumb {
  label: string;
  href?: string;
}
interface Props {
  title: string;
  lead?: string;
  kicker?: string;
  crumbs?: Crumb[];
}
const { title, lead, kicker, crumbs = [] } = Astro.props;
---

<section class="page-hero">
  <div class="container">
    {crumbs.length > 0 && (
      <nav class="crumbs" aria-label="Ruta de navegación">
        <a href={asset('/')}>Inicio</a>
        {crumbs.map((c) => (
          <>
            <span aria-hidden="true">/</span>
            {c.href ? <a href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>}
          </>
        ))}
      </nav>
    )}
    {kicker && <div class="kicker"><span class="kicker-line"></span><span>{kicker}</span></div>}
    <h1 class="page-title">{title}</h1>
    {lead && <p class="page-lead">{lead}</p>}
  </div>
</section>
